{
	"$schema": "https://schemas.wp.org/wp/7.0/theme.json",
	"version": 3,
	"settings": {
		"appearanceTools": false,
		"color": {
			"custom": false,
			"customDuotone": false,
			"customGradient": false,
			"defaultDuotone": false,
			"defaultGradients": false,
			"defaultPalette": false,
			"palette": [
				{
					"color": "#fff9de",
					"name": "Crème",
					"slug": "cream"
				},
				{
					"color": "#fffefa",
					"name": "Paneel",
					"slug": "panel"
				},
				{
					"color": "#ffffff",
					"name": "Wit",
					"slug": "white"
				},
				{
					"color": "#d91e26",
					"name": "Rood",
					"slug": "brand"
				},
				{
					"color": "#971217",
					"name": "Donkerrood",
					"slug": "brand-dark"
				},
				{
					"color": "#dfb248",
					"name": "Goud",
					"slug": "gold"
				},
				{
					"color": "#079e42",
					"name": "Groen",
					"slug": "green"
				},
				{
					"color": "#442200",
					"name": "Bruin",
					"slug": "brown"
				},
				{
					"color": "#222222",
					"name": "Donker",
					"slug": "dark"
				}
			]
		},
		"dimensions": {
			"defaultAspectRatios": true,
			"aspectRatios": [
				{
					"name": "Panorama - 21:9",
					"slug": "panorama",
					"ratio": "21/9"
				}
			]
		},
		"layout": {
			"contentSize": "720px",
			"wideSize": "1100px"
		},
		"spacing": {
			"customSpacingSize": false,
			"defaultSpacingSizes": false,
			"spacingSizes": [
				{
					"name": "XXS",
					"size": "0.375rem",
					"slug": "10"
				},
				{
					"name": "XS",
					"size": "0.75rem",
					"slug": "20"
				},
				{
					"name": "S",
					"size": "1rem",
					"slug": "30"
				},
				{
					"name": "M",
					"size": "clamp(1.25rem, 2vw, 1.75rem)",
					"slug": "40"
				},
				{
					"name": "L",
					"size": "clamp(2rem, 4vw, 3.5rem)",
					"slug": "50"
				},
				{
					"name": "XL",
					"size": "clamp(3rem, 7vw, 6rem)",
					"slug": "60"
				}
			],
			"units": [
				"px",
				"rem",
				"%",
				"vw"
			]
		},
		"typography": {
			"customFontSize": false,
			"defaultFontSizes": false,
			"fluid": true,
			"fontFamilies": [
				{
					"fontFamily": "-apple-system, BlinkMacSystemFont, \"Segoe UI\", sans-serif",
					"name": "Systeem",
					"slug": "system"
				},
				{
					"fontFamily": "Arvo, Georgia, serif",
					"fontFace": [
						{
							"fontFamily": "Arvo",
							"fontStyle": "normal",
							"fontWeight": "400",
							"src": [
								"file:./css/fonts/arvo-latin-400.woff2"
							]
						},
						{
							"fontFamily": "Arvo",
							"fontStyle": "normal",
							"fontWeight": "700",
							"src": [
								"file:./css/fonts/arvo-latin-700.woff2"
							]
						}
					],
					"name": "Arvo",
					"slug": "arvo"
				},
				{
					"fontFamily": "Bevan, Georgia, serif",
					"fontFace": [
						{
							"fontFamily": "Bevan",
							"fontStyle": "normal",
							"fontWeight": "400",
							"src": [
								"file:./css/fonts/bevan-latin-400.woff2"
							]
						}
					],
					"name": "Bevan",
					"slug": "bevan"
				}
			],
			"fontSizes": [
				{
					"fluid": false,
					"name": "Klein",
					"size": "0.875rem",
					"slug": "small"
				},
				{
					"fluid": {
						"min": "1rem",
						"max": "1.125rem"
					},
					"name": "Normaal",
					"size": "1rem",
					"slug": "medium"
				},
				{
					"fluid": {
						"min": "1.25rem",
						"max": "1.5rem"
					},
					"name": "Groot",
					"size": "1.25rem",
					"slug": "large"
				},
				{
					"fluid": {
						"min": "1.75rem",
						"max": "2.5rem"
					},
					"name": "Extra groot",
					"size": "2rem",
					"slug": "x-large"
				},
				{
					"fluid": {
						"min": "2.25rem",
						"max": "3.75rem"
					},
					"name": "Display",
					"size": "3rem",
					"slug": "display"
				}
			]
		},
		"useRootPaddingAwareAlignments": true
	},
	"styles": {
		"color": {
			"background": "var:preset|color|cream",
			"text": "var:preset|color|brown"
		},
		"spacing": {
			"blockGap": "var:preset|spacing|30"
		},
		"typography": {
			"fontFamily": "var:preset|font-family|system",
			"fontSize": "var:preset|font-size|medium",
			"lineHeight": "1.65"
		},
		"elements": {
			"button": {
				"border": {
					"radius": "0.25rem"
				},
				"color": {
					"background": "var:preset|color|brand",
					"text": "var:preset|color|white"
				},
				"typography": {
					"fontFamily": "var:preset|font-family|arvo",
					"fontWeight": "700"
				}
			},
			"h1": {
				"color": {
					"text": "var:preset|color|brand"
				},
				"typography": {
					"fontFamily": "var:preset|font-family|bevan",
					"fontSize": "var:preset|font-size|display",
					"fontWeight": "400",
					"lineHeight": "1.12"
				}
			},
			"h2": {
				"color": {
					"text": "var:preset|color|brand"
				},
				"typography": {
					"fontFamily": "var:preset|font-family|arvo",
					"fontSize": "var:preset|font-size|x-large",
					"fontWeight": "700",
					"lineHeight": "1.2"
				}
			},
			"h3": {
				"typography": {
					"fontFamily": "var:preset|font-family|arvo",
					"fontWeight": "700",
					"lineHeight": "1.3"
				}
			},
			"link": {
				"color": {
					"text": "var:preset|color|brand-dark"
				}
			}
		},
		"blocks": {
			"core/navigation": {
				"typography": {
					"fontFamily": "var:preset|font-family|arvo",
					"fontSize": "var:preset|font-size|small",
					"fontWeight": "700"
				}
			},
			"core/post-date": {
				"color": {
					"text": "var:preset|color|brand-dark"
				},
				"typography": {
					"fontFamily": "var:preset|font-family|arvo",
					"fontSize": "var:preset|font-size|small"
				}
			},
			"core/post-excerpt": {
				"typography": {
					"fontSize": "var:preset|font-size|medium"
				}
			},
			"core/query-pagination": {
				"typography": {
					"fontFamily": "var:preset|font-family|arvo",
					"fontWeight": "700"
				}
			},
			"core/search": {
				"typography": {
					"fontFamily": "var:preset|font-family|arvo"
				}
			}
		}
	},
	"customTemplates": [
		{
			"name": "landing-page",
			"postTypes": [
				"page"
			],
			"title": "Landingspagina"
		},
		{
			"name": "template-news-page",
			"postTypes": [
				"page"
			],
			"title": "Nieuws-pagina"
		}
	],
	"templateParts": [
		{
			"area": "header",
			"name": "header",
			"title": "Header"
		},
		{
			"area": "footer",
			"name": "footer",
			"title": "Footer"
		}
	]
}
